# NexusRAG Enterprise v0.2.0 Environment Variables

# Security & Authentication
NEXUSRAG_JWT_SECRET=your-secure-random-256bit-secret-here
JWT_EXPIRE_SECONDS=86400
ALLOWED_ORIGINS=*

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=200

# OpenAI API (Optional - local TF-IDF/SVD vectorizer used if omitted)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# PDF Inspector & Performance Settings
ENABLE_PDF_INSPECTOR=true
PDF_OCR_ROUTING_THRESHOLD=0.5
PRESERVE_TABLE_CHUNKS=true
